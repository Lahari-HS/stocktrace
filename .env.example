# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas (or leave blank to use in-memory DB for local dev)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/stocktrace?retryWrites=true&w=majority

# CORS origin for local dev (not needed in production — same origin)
CLIENT_ORIGIN=http://localhost:5173
